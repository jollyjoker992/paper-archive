# Copy to .env (never committed). Real environment variables win over this file.

# Where people.toml, documents/ and fhir/ live. Default: ./data
#PAPER_ARCHIVE_DIR=/Users/me/paper-data

# Medplum (FHIR R4) for `paper_archive.py load`: a read-write client of the project that holds the family's data.
#PAPER_FHIR_URL=http://localhost:8303
#PAPER_FHIR_PROJECT_ID=
#PAPER_FHIR_CLIENT_ID=
#PAPER_FHIR_CLIENT_SECRET=

# Base of the identifier systems. Never change it after the first load.
#PAPER_FHIR_BASE=https://github.com/jollyjoker992/paper-archive/fhir
