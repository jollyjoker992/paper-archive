# Copy to .env (never committed). Real environment variables win over this file.

# Where people.toml, documents/ and fhir/ live. Default: ./data
#PAPER_ARCHIVE_DIR=/Users/me/paper-data

# Medplum (FHIR R4) for `paper_archive.py load`: a read-write client of the project that holds the family's data.
#PAPER_FHIR_URL=http://localhost:8303
#PAPER_FHIR_PROJECT_ID=
#PAPER_FHIR_CLIENT_ID=
#PAPER_FHIR_CLIENT_SECRET=

# Cloud backup (`paper_archive.py backup`, docs/backup.md). A target is on when its variables are set.
# Choose one: encrypted with a key from `paper_archive.py backup new-key`, or readable by the provider.
#PAPER_BACKUP_KEY=
#PAPER_BACKUP_PLAIN=true
#PAPER_AWS_ACCESS_KEY_ID=
#PAPER_AWS_SECRET_ACCESS_KEY=
#PAPER_AWS_BUCKET=my-bucket/paper
#PAPER_AWS_REGION=ap-southeast-1
#PAPER_R2_ACCOUNT_ID=
#PAPER_R2_ACCESS_KEY_ID=
#PAPER_R2_SECRET_ACCESS_KEY=
#PAPER_R2_BUCKET=paper-backup
#PAPER_GDRIVE_CLIENT_ID=
#PAPER_GDRIVE_CLIENT_SECRET=
#PAPER_GDRIVE_TOKEN=
#PAPER_GDRIVE_FOLDER=paper-archive
#PAPER_BACKUP_RCLONE_REMOTE=/Volumes/Backup/paper
#PAPER_RCLONE_BIN=/opt/homebrew/bin/rclone

# Base of the identifier systems. Never change it after the first load.
#PAPER_FHIR_BASE=https://github.com/jollyjoker992/paper-archive/fhir
